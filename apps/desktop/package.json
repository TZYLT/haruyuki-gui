{
  "name": "@haruyuki/desktop",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "setup:electron": "node ../../node_modules/electron/install.js",
    "build": "node scripts/build-main.mjs && vite build --config vite.renderer.mts && vite build --config vite.probe.mts",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build --config vite.renderer.mts",
    "start": "electron dist/main/main.cjs",
    "typecheck": "tsc --noEmit",
    "build:probe": "vite build --config vite.probe.mts",
    "smoke:engine": "node scripts/smoke-engine.mjs",
    "smoke:supervision": "node scripts/supervision-smoke.mjs",
    "verify:gui-host": "node scripts/verify-gui-host.mjs",
    "verify:bridge-transport": "node scripts/verify-bridge-transport.mjs",
    "verify:bootstrap-error": "node scripts/verify-bootstrap-error.mjs",
    "verify:media": "node scripts/verify-media.mjs",
    "verify:host-port": "node scripts/verify-host-port.mjs"
  },
  "dependencies": {
    "@haruyuki/core": "workspace:*",
    "@haruyuki/protocol": "workspace:*",
    "@haruyuki/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
