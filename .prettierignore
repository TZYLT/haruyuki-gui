# Paths Prettier must not format or check.
#
# Internal documentation and exploration residue live outside the public repo
# (see .gitignore) and carry their own formatting conventions.
docs/
_research/

# Gate self-test fixtures are deliberately malformed and mis-sized; formatting
# them would destroy the very thing the gate asserts.
fixtures/

# Generated contract snapshot: one command/message per line is deliberate (a
# pretty-printed copy would exceed the 2000-line file rule and make every wire
# change a multi-line diff). The byte layout is the artifact, not a style choice.
packages/protocol/src/contract/snapshot.json

coverage/
dist/
out/
build/

# Generated by the package manager; never hand-formatted.
pnpm-lock.yaml

# Vendored third-party sources keep upstream formatting.
third_party/
vendor/
