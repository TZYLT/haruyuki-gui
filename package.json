{
  "name": "haruyuki-gui",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Desktop GUI foundation: an Electron shell and a VS Code extension shell sharing one core.",
  "license": "Apache-2.0",
  "keywords": [
    "electron",
    "vscode-extension",
    "typescript",
    "monorepo"
  ],
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && pnpm exec tsc -p scripts",
    "lint": "eslint .",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "contract:update": "node scripts/contract/cli.mjs update",
    "contract:check": "node scripts/contract/cli.mjs check",
    "contract:diff": "node scripts/contract/cli.mjs diff",
    "contract:generate": "node scripts/contract/cli.mjs generate",
    "test": "vitest run",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.23",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "jsdom": "31.0.1",
    "madge": "8.0.0",
    "playwright-core": "^1.65.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
