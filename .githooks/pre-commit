#!/bin/sh
# .githooks/pre-commit - fast local commit gate (budget: under 3 seconds).
#
# Install: pnpm hooks:install   (sets `git config core.hooksPath .githooks`)
# Bypass:  git commit --no-verify
#
# Three checks; the first failure aborts the commit with exit code 1:
#   1. eslint on the staged source files (.ts .mts .cts .js .mjs .cjs)
#   2. the 1000-line per-file limit (node scripts/check-file-size.mjs, whole tree)
#   3. prettier --check on the same staged source files
#
# Deliberately NOT run here: typecheck, unit tests, check-cycles.mjs (madge takes
# seconds) and any repository-wide eslint run. Those belong to full verification,
# never to a commit hook.
#
# Requires git, node >= 24 and pnpm on PATH (corepack shims are fine).
# Output is English, one line per step; each tool prints its own details.

set -u

say() {
  printf 'pre-commit: %s\n' "$1"
}

die() {
  printf 'pre-commit: %s\n' "$1" >&2
  printf 'pre-commit: commit aborted (git commit --no-verify skips this hook).\n' >&2
  exit 1
}

# Some clients invoke hooks from a subdirectory; never depend on the caller's cwd.
root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git work tree"
cd "$root" || die "cannot enter the repository root: $root"

for tool in node pnpm; do
  command -v "$tool" >/dev/null 2>&1 ||
    die "$tool is not on PATH; install Node.js >= 24 and run: corepack enable"
done

# Both lists are newline-separated: a path may contain spaces, so never split on
# spaces or tabs. `set -f` keeps a staged path from being expanded as a glob.
newline='
'
IFS=$newline
set -f

# Added, copied or modified files only: a deletion has nothing to lint. The
# pathspecs are not needed for correctness (the loop below filters again) but
# they keep the index read cheap on a large commit.
staged=$(git diff --cached --name-only --diff-filter=ACM -- \
  '*.ts' '*.mts' '*.cts' '*.js' '*.mjs' '*.cjs') ||
  die "cannot read the staged file list (git diff --cached failed)"

# Second filter, deliberately redundant with the git pathspecs: whatever reaches
# the list, only existing files with a script extension are handed to the tools.
# A stray non-source path (README.md, .gitignore, ...) would otherwise make
# prettier fail on "no parser could be inferred" and block an innocent commit.
files=""
count=0
for file in $staged; do
  [ -n "$file" ] || continue
  [ -f "$file" ] || continue
  case $file in
    *.ts|*.mts|*.cts|*.js|*.mjs|*.cjs) ;;
    *) continue ;;
  esac
  files="${files}${file}${newline}"
  count=$((count + 1))
done

if [ "$count" -eq 0 ]; then
  say "1/3 eslint: skipped, no staged source file"
else
  say "1/3 eslint: $count staged file(s)"
  # --no-warn-ignored: a staged file can still match an eslint ignore pattern
  # (a fixture, for example); a matching ignore is not a lint failure.
  if ! pnpm exec eslint --no-warn-ignored $files; then
    printf 'pre-commit: eslint found problems in the staged files.\n' >&2
    printf 'pre-commit: fix them, then stage the files again (git add ...).\n' >&2
    die "eslint failed"
  fi
fi

say "2/3 file-size: whole tree"
if ! node scripts/check-file-size.mjs; then
  printf 'pre-commit: a file is over the 1000-line limit (or over its recorded baseline).\n' >&2
  printf 'pre-commit: split it, or lower scripts/source-file-size-baseline.json.\n' >&2
  die "file-size failed"
fi

if [ "$count" -eq 0 ]; then
  say "3/3 prettier: skipped, no staged source file"
else
  say "3/3 prettier: $count staged file(s)"
  if ! pnpm exec prettier --check $files; then
    printf 'pre-commit: prettier found unformatted staged files.\n' >&2
    printf 'pre-commit: run: pnpm exec prettier --write'
    printf ' %s' $files
    printf '\n'
    printf 'pre-commit: then stage the result again (git add ...).\n' >&2
    die "prettier failed"
  fi
fi

say "ok"
