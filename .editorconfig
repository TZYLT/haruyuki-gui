root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: two trailing spaces are a hard line break, so leave them alone.
[*.md]
trim_trailing_whitespace = false

# Windows batch files require CRLF.
[*.{bat,cmd}]
end_of_line = crlf
