{
  "note": "Tool-call assembly. One block per call, arguments append but a complete record replaces, a plural return closes several calls, a later return overwrites an earlier one, the client end marker is not a closing edge, an orphan result keeps its payload, and turn.finished is the only incomplete signal.",
  "cases": [
    {
      "name": "the client end marker does not close the call",
      "path": "tools",
      "input": {
        "messages": [
          {
            "id": "tc-a1",
            "messageType": "tool_call_message",
            "role": "tool",
            "runId": "run-7",
            "body": {
              "tool_call_id": "call-1",
              "name": "shell",
              "arguments": "{\"cmd\":\""
            }
          },
          {
            "id": "tc-a2",
            "messageType": "tool_call_message",
            "role": "tool",
            "runId": "run-7",
            "body": {
              "tool_call_id": "call-1",
              "name": "shell",
              "arguments": "ls -la\"}"
            }
          },
          {
            "id": "tc-a3",
            "messageType": "client_tool_end",
            "role": "tool",
            "runId": "run-7",
            "body": {
              "tool_call_id": "call-1",
              "status": "success"
            }
          }
        ]
      },
      "expect": [
        {
          "id": "tool:call-1",
          "messageId": "tc-a1",
          "runId": "run-7",
          "role": "tool",
          "type": "tool_call",
          "toolCallId": "call-1",
          "name": "shell",
          "argumentsText": "{\"cmd\":\"ls -la\"}",
          "result": null,
          "status": "running",
          "orphan": false
        }
      ]
    },
