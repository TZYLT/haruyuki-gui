          "id": "tool:call-b",
          "messageId": "tc-b1",
          "runId": "run-8",
          "role": "tool",
          "type": "tool_call",
          "toolCallId": "call-b",
          "name": "read",
          "argumentsText": "{\"path\":\"b\"}",
          "result": "missing-b",
          "status": "error",
          "orphan": false
        }
      ]
