{
  "note": "Fenced code on the live path: the scanner sees one delta frame at a time, an opener is only real once its newline arrives, and an unclosed fence is still complete once the message is.",
  "cases": [
    {
      "name": "a ts fence keeps its info string and the code verbatim",
      "path": "live-text",
      "input": {
        "messageId": "live-code",
        "runId": "run-code",
        "frames": [
          {
            "text": "Here is the helper:\n```ts\nconst add = (a: number, b: number) => a + b;\n"
          },
          {
            "text": "```\n"
          },
          {
            "text": "It returns the sum.\n"
          }
        ]
      },
      "expect": [
        {
          "id": "live-code:text:0",
          "messageId": "live-code",
          "runId": "run-code",
          "role": "assistant",
          "type": "text",
          "text": "Here is the helper:\n",
          "flavor": "markdown",
          "status": "complete"
        },
        {
          "id": "live-code:code:0",
          "messageId": "live-code",
          "runId": "run-code",
          "role": "assistant",
          "type": "code",
          "text": "const add = (a: number, b: number) => a + b;\n",
          "info": "ts",
          "closed": true,
          "status": "complete"
        },
        {
          "id": "live-code:text:1",
          "messageId": "live-code",
          "runId": "run-code",
          "role": "assistant",
          "type": "text",
          "text": "It returns the sum.\n",
          "flavor": "markdown",
          "status": "complete"
        }
      ]
    },
    {
      "name": "tilde and unclosed fences both become code blocks",
