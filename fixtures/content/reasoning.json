            "role": "assistant",
            "runId": "run-r",
            "body": {
              "reasoning": " world",
              "seq_id": 2
            }
          },
          {
            "id": "msg-r1:reasoning:0",
            "messageType": "reasoning_message",
            "role": "assistant",
            "runId": "run-r",
            "body": {
              "reasoning": "hello",
              "seq_id": 1
            }
          }
        ]
      },
      "expect": [
        {
          "id": "msg-r1:reasoning:0",
          "messageId": "msg-r1",
          "runId": "run-r",
          "role": "assistant",
          "type": "reasoning",
          "text": "hello world"
        }
